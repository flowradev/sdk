{
  "name": "@flowra/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Flowra API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "generate": "bash ../scripts/generate-typescript.sh",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "flowra",
    "sdk",
    "agents",
    "workflows",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/flowradev/sdk.git",
    "directory": "typescript"
  },
  "homepage": "https://flowra.dev",
  "bugs": {
    "url": "https://github.com/flowradev/sdk/issues"
  }
}
